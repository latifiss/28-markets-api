# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=api
MONGODB_MAX_POOL_SIZE=30

# Authentication: generate a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Upstash Redis (use the rediss:// TLS URL from the Upstash console).
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Server
PORT=6060
NODE_ENV=development
TRUST_PROXY=1

# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:3000,https://28-markets.com

# Optional administrator allowlist (comma-separated MongoDB user IDs).
MARKET_DATA_ADMIN_USER_IDS=

# Distributed request limits.
API_RATE_LIMIT_MAX=600
API_WRITE_RATE_LIMIT_MAX=60
API_IP_RATE_LIMIT_MAX=1200
AUTH_RATE_LIMIT_MAX=10

# Cache and asynchronous usage analytics.
PUBLIC_RESPONSE_CACHE_TTL_SECONDS=15
CACHE_L1_MAX_ENTRIES=5000
USAGE_WORKER_BATCH_SIZE=500
USAGE_WORKER_POLL_MS=500
